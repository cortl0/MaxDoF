compositor_node MaxDoFWorkspace_Node
{
    in 0 renderwindow
 
    target renderwindow
    {
        pass render_scene
        {
            load
            {
                all clear
                clear_colour 0.2 0.4 0.6 1.0
            }
 
            rq_first    0
            rq_last     max

			overlays	on
			shadows		MaxDoFShadowNode
        }
    }
}

compositor_node_shadow MaxDoFShadowNode
{
    technique focused
    texture focusedTex 2048 2048 PFG_D32_FLOAT
    shadow_map 0 focusedTex light 0
    // Render shadow map "0"
    shadow_map_target_type directional spot
    {
        shadow_map 0
        {
            pass render_scene
            {
                load
                {
                    all clear
                }
                rq_first 0
                rq_last max
            }
        }
    }
}

workspace MaxDoFWorkspace
{
    connect_output MaxDoFWorkspace_Node 0
}